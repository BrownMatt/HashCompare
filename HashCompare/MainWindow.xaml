<Window x:Class="HashCompare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Hash Compare" Height="650" Width="1100">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Only the Status cell is colored, based on its value -->
        <Style x:Key="StatusCellStyle" TargetType="DataGridCell">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="New">
                    <Setter Property="Background" Value="#A5D6A7"/>  <!-- Light Green -->
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Missing">
                    <Setter Property="Background" Value="#EF9A9A"/>  <!-- Light Red -->
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Different">
                    <Setter Property="Background" Value="#FFF59D"/>  <!-- Light Yellow -->
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Identical">
                    <Setter Property="Background" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Bold, slightly indented text for the Folder column (easier to read) -->
        <Style x:Key="FolderCellText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
        </Style>

        <!-- Bold text for the File column -->
        <Style x:Key="FileCellText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Source Folder Selection (editable history dropdown + Browse) -->
            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <DockPanel Margin="0,0,0,5">
                    <Button x:Name="BtnSwapFolders" Content="Swap folders" DockPanel.Dock="Right" Width="90"
                            Click="btnSwapFolders_Click"/>
                    <TextBlock Text="Source Folder:" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel>
                    <Button x:Name="BtnSourceFolder" Content="Browse..." DockPanel.Dock="Right" Width="80" Click="btnSourceFolder_Click"/>
                    <ComboBox x:Name="CmbSourceFolder" IsEditable="True" IsTextSearchEnabled="False"
                              SelectionChanged="CmbSourceFolder_SelectionChanged"/>
                </DockPanel>
            </StackPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Destination Folder Selection -->
            <StackPanel Grid.Column="2" Margin="5,0,0,0">
                <TextBlock Text="Destination Folder:" Margin="0,0,0,5"/>
                <DockPanel>
                    <Button x:Name="BtnDestFolder" Content="Browse..." DockPanel.Dock="Right" Width="80" Click="btnDestFolder_Click"/>
                    <TextBox x:Name="TxtDestFolder" IsReadOnly="True"/>
                </DockPanel>
            </StackPanel>
        </Grid>

        <!-- Action buttons + progress -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button x:Name="BtnCompare" Content="Compare Folders" Padding="5" Margin="0,0,8,0" Click="btnCompare_Click"/>
            <Button x:Name="BtnConfig" Content="Config" Padding="5" Width="80" Click="btnConfig_Click"/>
            <ProgressBar x:Name="CompareProgress" Width="220" Height="18" Margin="16,0,0,0"
                         VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtProgress" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Filter Controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,10" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <TextBlock Text="Filter by Status:" VerticalAlignment="Bottom" Margin="0,0,10,2" FontWeight="SemiBold"/>

            <!-- Each filter shows a live count of matching files above its checkbox -->
            <StackPanel Margin="5,0" VerticalAlignment="Bottom">
                <TextBlock x:Name="TxtCountIdentical" Text="0" FontWeight="Bold" HorizontalAlignment="Center"/>
                <CheckBox x:Name="ChkIdentical" Content="Identical" Checked="FilterCheckBox_Changed" Unchecked="FilterCheckBox_Changed"/>
            </StackPanel>
            <StackPanel Margin="5,0" VerticalAlignment="Bottom">
                <TextBlock x:Name="TxtCountDifferent" Text="0" FontWeight="Bold" HorizontalAlignment="Center"/>
                <CheckBox x:Name="ChkDifferent" Content="Different" IsChecked="True" Checked="FilterCheckBox_Changed" Unchecked="FilterCheckBox_Changed"/>
            </StackPanel>
            <StackPanel Margin="5,0" VerticalAlignment="Bottom">
                <TextBlock x:Name="TxtCountMissing" Text="0" FontWeight="Bold" HorizontalAlignment="Center"/>
                <CheckBox x:Name="ChkMissing" Content="Missing" IsChecked="True" Checked="FilterCheckBox_Changed" Unchecked="FilterCheckBox_Changed"/>
            </StackPanel>
            <StackPanel Margin="5,0" VerticalAlignment="Bottom">
                <TextBlock x:Name="TxtCountNew" Text="0" FontWeight="Bold" HorizontalAlignment="Center"/>
                <CheckBox x:Name="ChkNew" Content="New" IsChecked="True" Checked="FilterCheckBox_Changed" Unchecked="FilterCheckBox_Changed"/>
            </StackPanel>

            <!-- Color Legend -->
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Margin="20,0,0,0" Padding="5,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Legend: " FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Width="16" Height="16" Background="#A5D6A7" Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="New" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <Border Width="16" Height="16" Background="#EF9A9A" Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Missing" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <Border Width="16" Height="16" Background="#FFF59D" Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Different" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <Border Width="16" Height="16" Background="White" BorderBrush="Gray" BorderThickness="1" Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Identical" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <DataGrid x:Name="DgResults" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                  AlternatingRowBackground="{x:Null}"
                  Margin="0,5,0,0">
            <DataGrid.Columns>
                <!-- Folder = 1/2 of the grid, File = 1/4, Status + Actions share the last 1/4 -->
                <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="2*" ElementStyle="{StaticResource FolderCellText}"/>
                <DataGridTextColumn Header="File" Binding="{Binding File}" Width="1*" ElementStyle="{StaticResource FileCellText}"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.4*" CellStyle="{StaticResource StatusCellStyle}"/>
                <DataGridTemplateColumn Header="Actions" Width="0.6*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Copy to Dest" Margin="2,1" Padding="6,1"
                                        Visibility="{Binding CanCopyToDest, Converter={StaticResource BoolToVis}}"
                                        Click="CopyToDest_Click"/>
                                <Button Content="Remove from Dest" Margin="2,1" Padding="6,1"
                                        Visibility="{Binding CanRemoveFromDest, Converter={StaticResource BoolToVis}}"
                                        Click="RemoveFromDest_Click"/>
                                <Button Content="Replace Dest" Margin="2,1" Padding="6,1"
                                        Visibility="{Binding CanReplaceDest, Converter={StaticResource BoolToVis}}"
                                        Click="ReplaceDest_Click"/>
                                <Button Content="Compare" Margin="2,1" Padding="6,1"
                                        Visibility="{Binding CanCompare, Converter={StaticResource BoolToVis}}"
                                        Click="CompareFiles_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
