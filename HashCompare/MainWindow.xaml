<Window x:Class="HashCompare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HashCompare"
        mc:Ignorable="d"
        Title="Hash Compare" Height="600" Width="1000">
    <Window.Resources>
        <!-- Style for DataGrid rows based on Status -->
        <Style x:Key="RowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="New">
                    <Setter Property="Background" Value="#A5D6A7"/>  <!-- Light Green -->
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Missing">
                    <Setter Property="Background" Value="#EF9A9A"/>  <!-- Light Red -->
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Different">
                    <Setter Property="Background" Value="#FFF59D"/>  <!-- Light Yellow -->
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Identical">
                    <Setter Property="Background" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Source Folder Selection -->
            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                <TextBlock Text="Source Folder:" Margin="0,0,0,5"/>
                <DockPanel>
                    <Button x:Name="btnSourceFolder" Content="Browse..." DockPanel.Dock="Right" Width="80" Click="btnSourceFolder_Click"/>
                    <TextBox x:Name="txtSourceFolder" IsReadOnly="True"/>
                </DockPanel>
            </StackPanel>
            
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
            
            <!-- Target Folder Selection -->
            <StackPanel Grid.Column="2" Margin="5,0,0,0">
                <TextBlock Text="Target Folder:" Margin="0,0,0,5"/>
                <DockPanel>
                    <Button x:Name="btnTargetFolder" Content="Browse..." DockPanel.Dock="Right" Width="80" Click="btnTargetFolder_Click"/>
                    <TextBox x:Name="txtTargetFolder" IsReadOnly="True"/>
                </DockPanel>
            </StackPanel>
        </Grid>

        <Button x:Name="btnCompare" Grid.Row="1" Content="Compare Folders" Margin="0,10" Padding="5" Click="btnCompare_Click" HorizontalAlignment="Center"/>

        <!-- Filter Controls -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,10" HorizontalAlignment="Left">
            <TextBlock Text="Filter by Status:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
            <CheckBox x:Name="chkIdentical" Content="Identical" Margin="5,0" Checked="FilterCheckBox_Changed" Unchecked="FilterCheckBox_Changed"/>
            <CheckBox x:Name="chkDifferent" Content="Different" Margin="5,0" IsChecked="True" Checked="FilterCheckBox_Changed" Unchecked="FilterCheckBox_Changed"/>
            <CheckBox x:Name="chkMissing" Content="Missing" Margin="5,0" IsChecked="True" Checked="FilterCheckBox_Changed" Unchecked="FilterCheckBox_Changed"/>
            <CheckBox x:Name="chkNew" Content="New" Margin="5,0" IsChecked="True" Checked="FilterCheckBox_Changed" Unchecked="FilterCheckBox_Changed"/>
            
            <!-- Color Legend -->
            <Border BorderThickness="0 0 0 1" BorderBrush="Gray" Margin="20,0,0,0" Padding="5,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Legend: " FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Width="16" Height="16" Background="#A5D6A7" Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="New" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    
                    <Border Width="16" Height="16" Background="#EF9A9A" Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Missing" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    
                    <Border Width="16" Height="16" Background="#FFF59D" Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Different" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    
                    <Border Width="16" Height="16" Background="White" BorderBrush="Gray" BorderThickness="1" Margin="5,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Identical" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <DataGrid x:Name="dgResults" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" 
                  AlternatingRowBackground="{x:Null}"
                  RowStyle="{StaticResource RowStyle}"
                  Margin="0,5,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="File Path" Binding="{Binding FilePath}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="CRC32 Source" Binding="{Binding CRC32Source}" Width="120"/>
                <DataGridTextColumn Header="CRC32 Target" Binding="{Binding CRC32Target}" Width="120"/>
                <DataGridTextColumn Header="SHA256 Source" Binding="{Binding SHA256Source}" Width="300"/>
                <DataGridTextColumn Header="SHA256 Target" Binding="{Binding SHA256Target}" Width="300"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
